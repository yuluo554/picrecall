*.py[cod]
*.egg-info/
build/
dist/
.eggs/
venv/
.venv/
env/

# 环境与密钥
.env
.env.*

# 本项目：索引库与模型缓存（隐私红线，绝不入库）
*.db
*.sqlite
*.sqlite3
models/
